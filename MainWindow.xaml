<Window x:Class="CallAudioRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:CallAudioRecorder.Models"
        xmlns:l="clr-namespace:CallAudioRecorder"
        Title="Call Recorder" Width="980" Height="920" MinWidth="900" MinHeight="800"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource BodyFont}" TextOptions.TextRenderingMode="ClearType">

    <!-- Оверлей на иконке панели задач: красная точка во время записи (ставится в SetRecordingUi) -->
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarInfo"/>
    </Window.TaskbarItemInfo>

    <Window.Resources>
        <!-- Красная точка записи для оверлея панели задач (рисуется в правом нижнем углу иконки) -->
        <DrawingImage x:Key="RecOverlayIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#E53935">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="8,8" RadiusX="6" RadiusY="6"/>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="White" Thickness="2"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>

        <Storyboard x:Key="Pulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="RecDot" Storyboard.TargetProperty="Opacity"
                             From="1" To="0.15" Duration="0:0:0.55"/>
        </Storyboard>

        <!-- Реплика: таймкод отдельной колонкой, текст во всю ширину.
             Пузырей на пол-экрана больше нет — переписка на двоих это не расшифровка
             встречи с пятью участниками, а 340 px под текст на часовой записи не читаются.
             Подложка остаётся только у «Я»: контраст «я / все остальные» полезнее, чем
             «левый / правый». -->
        <DataTemplate x:Key="TranscriptBubble" DataType="{x:Type m:TranscriptEntry}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Моноширинный таймкод: разряды стоят колонкой, глаз цепляется за время -->
                <TextBlock Grid.Column="0" Text="{Binding TimeLabel}" FontSize="11"
                           FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Top" Margin="0,11,10,0"/>
                <Border Grid.Column="1" x:Name="bubble" CornerRadius="10" Padding="12,8"
                        Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="speakerName" Text="{Binding Speaker}" FontSize="11" FontWeight="SemiBold"
                                   FontFamily="{StaticResource DisplayFont}" Margin="0,0,0,3"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="{Binding Text}" FontSize="15" TextWrapping="Wrap"
                                   LineHeight="22" LineStackingStrategy="BlockLineHeight"
                                   Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMe}" Value="True">
                    <Setter TargetName="bubble" Property="Background" Value="#241B1F"/>
                    <Setter TargetName="bubble" Property="BorderBrush" Value="#3A2528"/>
                </DataTrigger>
                <!-- Цвет имени различает собеседников при диаризации (5-й и дальше — MutedBrush) -->
                <DataTrigger Binding="{Binding Speaker}" Value="Собеседник 1">
                    <Setter TargetName="speakerName" Property="Foreground" Value="#7FB2E5"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Speaker}" Value="Собеседник 2">
                    <Setter TargetName="speakerName" Property="Foreground" Value="#8FD48F"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Speaker}" Value="Собеседник 3">
                    <Setter TargetName="speakerName" Property="Foreground" Value="#E5B37F"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Speaker}" Value="Собеседник 4">
                    <Setter TargetName="speakerName" Property="Foreground" Value="#C79FE0"/>
                </DataTrigger>
                <!-- То же для английских меток: метки задаёт LanguageProfile, цвета — здесь -->
                <DataTrigger Binding="{Binding Speaker}" Value="Speaker 1">
                    <Setter TargetName="speakerName" Property="Foreground" Value="#7FB2E5"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Speaker}" Value="Speaker 2">
                    <Setter TargetName="speakerName" Property="Foreground" Value="#8FD48F"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Speaker}" Value="Speaker 3">
                    <Setter TargetName="speakerName" Property="Foreground" Value="#E5B37F"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Speaker}" Value="Speaker 4">
                    <Setter TargetName="speakerName" Property="Foreground" Value="#C79FE0"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- Внешний отступ под тень -->
    <Border Margin="14" Background="{StaticResource BgBrush}" CornerRadius="14"
            BorderBrush="#2A303C" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" Color="Black"/>
        </Border.Effect>

        <Grid Margin="18,10,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══════════ Заголовок окна ══════════ -->
            <Grid Grid.Row="0" Height="38" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource AccentBrush}" Margin="2,1,9,0"/>
                    <TextBlock Text="Call Recorder" Foreground="{StaticResource TextBrush}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:Tr '  запись · транскрипт · итоги', En='  record · transcribe · summarize'}" Foreground="{StaticResource MutedBrush}"
                               FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Язык интерфейса: подпись — язык, на который переключит кнопка.
                         По умолчанию язык берётся из Windows, выбор здесь сохраняется. -->
                    <Button x:Name="UiLanguageBtn" Style="{StaticResource TitleButton}"
                            Content="{l:Tr EN, En=RU}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                            ToolTip="{l:Tr 'Switch the interface to English', En='Переключить интерфейс на русский'}"
                            Click="UiLanguage_Click"/>
                    <Button Style="{StaticResource TitleButton}" Content="&#xE921;" FontFamily="Segoe MDL2 Assets"
                            FontSize="11" Click="Minimize_Click"/>
                    <Button Style="{StaticResource TitleButton}" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                            FontSize="10" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- ══════════ Две колонки ══════════ -->
            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="440"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ─────── Левая колонка: запись ─────── -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <!-- Карточки отдают место кнопке записи, а не наоборот: при нехватке высоты
                             прокручиваются они, а блок записи всегда остаётся целиком видимым. -->
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto" MinHeight="198"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
                    <StackPanel>

                    <!-- Источники -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr ИСТОЧНИКИ, En=SOURCES}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Icon}" Text="&#xE7C4;" Margin="2,0,0,8"/>
                                <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="SystemSource"
                                           Style="{StaticResource DarkCombo}" Margin="0,0,0,8"
                                           ToolTip="{l:Tr 'Откуда брать звук собеседника: всё устройство вывода или одно приложение', En='Where the other side audio comes from: the whole output device or a single app'}"
                                           DropDownOpened="SystemSource_DropDownOpened"
                                           SelectionChanged="SystemSource_SelectionChanged"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Icon}" Text="&#xE767;" Margin="2,0,0,8"/>
                                <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="RenderDevices"
                                           Style="{StaticResource DarkCombo}" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Icon}" Text="&#xE720;" Margin="2,0,0,0"/>
                                <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="CaptureDevices"
                                           Style="{StaticResource DarkCombo}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Микшер -->
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr МИКШЕР, En=MIXER}"/>

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="{l:Tr Система, En=System}" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                                <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                           Text="{Binding Value, ElementName=SystemGain, StringFormat={}{0:P0}}"/>
                            </Grid>
                            <Slider x:Name="SystemGain" Style="{StaticResource Fader}" Minimum="0" Maximum="2" Value="1"
                                    ValueChanged="Gain_Changed"/>
                            <ProgressBar x:Name="SystemVu" Style="{StaticResource Vu}" Margin="0,5,0,10"/>

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="{l:Tr Микрофон, En=Microphone}" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                                <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                           Text="{Binding Value, ElementName=MicGain, StringFormat={}{0:P0}}"/>
                            </Grid>
                            <Slider x:Name="MicGain" Style="{StaticResource Fader}" Minimum="0" Maximum="2" Value="1"
                                    ValueChanged="Gain_Changed"/>
                            <ProgressBar x:Name="MicVu" Style="{StaticResource Vu}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Настройки -->
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel x:Name="SettingsPanel">
                            <TextBlock Style="{StaticResource CardTitle}" Text="{l:Tr 'ВЫХОДНОЙ ФАЙЛ', En='OUTPUT FILE'}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{StaticResource FieldBrush}"
                                        BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                                        CornerRadius="9" Padding="3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="Br128" Style="{StaticResource Segment}" Content="128" FontSize="12" GroupName="br"/>
                                        <RadioButton x:Name="Br192" Style="{StaticResource Segment}" Content="192" FontSize="12" GroupName="br" IsChecked="True"/>
                                        <RadioButton x:Name="Br320" Style="{StaticResource Segment}" Content="320" FontSize="12" GroupName="br"/>
                                    </StackPanel>
                                </Border>

                                <TextBox Grid.Column="1" x:Name="OutputFolder" Style="{StaticResource PathBox}"
                                         Margin="10,0" VerticalAlignment="Center" FontSize="12"/>

                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Click="BrowseFolder_Click"
                                        VerticalAlignment="Center" ToolTip="{l:Tr 'Папка для записей', En='Recordings folder'}">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="14"/>
                                </Button>
                            </Grid>

                            <CheckBox x:Name="TranscribeCheck" Style="{StaticResource DarkCheck}" IsChecked="True"
                                      Content="{l:Tr 'Живой транскрипт (офлайн)', En='Live transcript (offline)'}" FontSize="12" Margin="2,12,0,2"/>

                            <Grid Margin="22,8,0,2" IsEnabled="{Binding IsChecked, ElementName=TranscribeCheck}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{l:Tr 'Язык речи', En='Speech language'}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextBrush}" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="1" x:Name="LanguageBox" Style="{StaticResource DarkCombo}"
                                          ToolTip="{l:Tr 'Русский — GigaAM v3, English — Parakeet TDT. Модель качается при первом выборе языка.', En='Русский (Russian): GigaAM v3, English: Parakeet TDT. The model is downloaded the first time a language is picked.'}"
                                          SelectionChanged="Language_Changed"/>
                            </Grid>

                            <CheckBox x:Name="DiarizeCheck" Style="{StaticResource DarkCheck}" IsChecked="True"
                                      Content="{l:Tr 'Различать собеседников по голосу', En='Tell speakers apart by voice'}" FontSize="12" Margin="22,6,0,2"
                                      IsEnabled="{Binding IsChecked, ElementName=TranscribeCheck}"
                                      Checked="Diarize_Changed" Unchecked="Diarize_Changed"/>
                        </StackPanel>
                    </Border>

                    </StackPanel>
                    </ScrollViewer>

                    <!-- Таймер и запись -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Margin="0,16,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <Ellipse x:Name="RecDot" Width="10" Height="10" Fill="{StaticResource AccentBrush}"
                                     VerticalAlignment="Center" Margin="0,4,10,0" Visibility="Hidden"/>
                            <TextBlock x:Name="Timer" Text="00:00:00" FontSize="40" FontWeight="Light"
                                       FontFamily="{StaticResource MonoFont}"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button x:Name="StartStop" Style="{StaticResource RecordButton}" Click="StartStop_Click"
                                HorizontalAlignment="Center">
                            <Rectangle x:Name="StopIcon" Width="22" Height="22" RadiusX="5" RadiusY="5"
                                       Fill="White" Visibility="Collapsed"/>
                        </Button>

                        <TextBlock x:Name="Hint" Text="{l:Tr 'нажмите, чтобы начать запись', En='click to start recording'}" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ─────── Правая колонка: транскрипт и итоги ─────── -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                    <TabControl x:Name="RightTabs" Style="{StaticResource DarkTabControl}">
                        <TabItem Style="{StaticResource DarkTabItem}" Header="{l:Tr Транскрипт, En=Transcript}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Настройки складываются: они нужны до записи, а лента — всё
                                     остальное время, и стоять стеной над ней им незачем. -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="0" x:Name="TranscriptSettingsToggle"
                                                  Style="{StaticResource SectionToggle}" IsChecked="True"
                                                  Content="{l:Tr 'НАСТРОЙКИ РАСШИФРОВКИ', En='TRANSCRIPT SETTINGS'}"
                                                  Checked="TranscriptSettings_Toggled" Unchecked="TranscriptSettings_Toggled"/>
                                    <!-- Выбор модели стоит здесь, а не в строке кнопок и не внутри
                                         складных настроек: в строке кнопок ему не хватало ширины
                                         и имя модели обрезалось, а свёрнутые настройки отобрали бы
                                         выбор совсем. Место в строке заголовка всё равно пустовало. -->
                                    <ComboBox Grid.Column="1" x:Name="TranscriptModels" Style="{StaticResource GhostCombo}" SelectionChanged="Model_SelectionChanged"
                                              VerticalAlignment="Center" MinWidth="120" MaxWidth="260"
                                              ToolTip="{l:Tr 'Модель Ollama для «Определить участников» и «Исправить текст». Выбор во вкладке «Итоги» независим.', En='Ollama model for Name speakers and Fix text. The Summary tab has its own, independent choice.'}"/>
                                </Grid>

                                <!-- Потолок и своя прокрутка: без них на низком окне настройки
                                     съедали всю высоту и от ленты оставалась полоска в 15 px
                                     (поймано снимком окна 900x700). -->
                                <ScrollViewer Grid.Row="1" MaxHeight="360" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Visibility="{Binding IsChecked, ElementName=TranscriptSettingsToggle,
                                                                   Converter={StaticResource BoolToVis}}">
                                <StackPanel x:Name="TranscriptSettings" Margin="2,0,2,10">
                                    <!-- Настройка склейки реплик -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{l:Tr 'Новый блок после паузы:', En='New block after a pause of:'}" FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <Slider Grid.Column="1" x:Name="MergeGapSlider" Style="{StaticResource Fader}"
                                                Minimum="1" Maximum="10" Value="3.5"
                                                TickFrequency="0.5" IsSnapToTickEnabled="True"
                                                ValueChanged="MergeGap_Changed"/>
                                        <!-- Единица — отдельным Run: в StringFormat язык интерфейса не подставить -->
                                        <TextBlock Grid.Column="2" FontSize="11" Foreground="{StaticResource TextBrush}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"><Run
                                            Text="{Binding Value, ElementName=MergeGapSlider, Mode=OneWay, StringFormat={}{0:0.0}}"/><Run
                                            Text="{l:Tr ' с', En=' s'}"/></TextBlock>
                                    </Grid>

                                    <!-- Имя владельца: чтобы оно не досталось собеседнику при разметке -->
                                    <TextBlock Text="{l:Tr 'Как зовут вас (для разметки спикеров):', En='Your name (for labelling speakers):'}" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,10,0,5"/>
                                    <TextBox x:Name="OwnerNameBox" Style="{StaticResource PathBox}"
                                             FontSize="12" LostFocus="OwnerName_LostFocus"
                                             ToolTip="{l:Tr 'Имя, которым к вам обращаются на встречах. Оно не будет присвоено собеседнику.', En='The name people call you in meetings. It will never be given to another speaker.'}"/>

                                    <!-- Глоссарий: улучшает и распознавание (hotwords), и LLM-коррекцию -->
                                    <TextBlock Text="{l:Tr 'Термины и имена встречи (через запятую):', En='Meeting terms and names (comma-separated):'}" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,10,0,5"/>
                                    <TextBox x:Name="GlossaryBox" Style="{StaticResource PathBox}"
                                             Height="50" FontSize="12" TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                             LostFocus="Glossary_LostFocus"
                                             ToolTip="{l:Tr 'Например: Телемост, NotebookLM, Kubernetes, Алексей, спринт', En='For example: Zoom, NotebookLM, Kubernetes, Alex, sprint'}"/>
                                    <!-- Глоссарий разрастается от встречи к встрече — поле тянется вниз,
                                         забирая высоту у ленты реплик (строка Auto у строки *). -->
                                    <Thumb x:Name="GlossaryGrip" Style="{StaticResource ResizeGrip}"
                                           DragDelta="GlossaryGrip_DragDelta" DragCompleted="GlossaryGrip_DragCompleted"
                                           ToolTip="{l:Tr 'Потяните, чтобы растянуть поле; двойной щелчок вернёт исходную высоту', En='Drag to make the box taller; double-click to reset its height'}"
                                           MouseDoubleClick="GlossaryGrip_MouseDoubleClick"/>

                                </StackPanel>
                                </ScrollViewer>

                                <!-- Действия и выбор модели остаются на виду, даже когда настройки
                                     свёрнуты: модель меняют чаще всего остального, и прятать её
                                     под заголовок значило бы отобрать выбор. -->
                                <Grid Grid.Row="2" Margin="2,0,2,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="NameSpeakersBtn" Style="{StaticResource ActionButton}"
                                            Click="NameSpeakers_Click" IsEnabled="False"
                                            ToolTip="{l:Tr 'Заменить метки «Собеседник N» на имена, которые прозвучали в разговоре', En='Replace the Speaker N labels with the names said in the conversation'}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE716;" FontSize="13" Margin="0,1,7,0"/>
                                            <TextBlock Text="{l:Tr 'Определить участников', En='Name speakers'}" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" x:Name="FixTextBtn" Style="{StaticResource ActionButton}"
                                            Margin="8,0,0,0" Click="FixText_Click" IsEnabled="False"
                                            ToolTip="{l:Tr 'Восстановить искажённые распознаванием термины и починить ошибки в репликах', En='Restore terms mangled by recognition and fix errors in the utterances'}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" FontSize="13" Margin="0,1,7,0"/>
                                            <TextBlock Text="{l:Tr 'Исправить текст', En='Fix text'}" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <ScrollViewer Grid.Row="3" x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="TranscriptList" ItemTemplate="{StaticResource TranscriptBubble}"/>
                                </ScrollViewer>
                                <TextBlock Grid.Row="3" x:Name="TranscriptEmpty" Text="{l:Tr 'Транскрипт появится здесь во время записи', En='The transcript will appear here while you record'}"
                                           Foreground="{StaticResource MutedBrush}" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </TabItem>

                        <TabItem Style="{StaticResource DarkTabItem}" Header="{l:Tr Итоги, En=Summary}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" x:Name="OllamaModels" Style="{StaticResource DarkCombo}" SelectionChanged="Model_SelectionChanged"
                                              Height="34"/>
                                    <Button Grid.Column="1" x:Name="MakeSummaryBtn" Style="{StaticResource ActionButton}"
                                            Margin="8,0,0,0" Click="MakeSummary_Click" IsEnabled="False">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" FontSize="13" Margin="0,1,7,0"/>
                                            <TextBlock Text="{l:Tr 'Сформировать итоги', En='Make summary'}" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Click="CopySummary_Click" ToolTip="{l:Tr Копировать, En=Copy}">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;" FontSize="13"/>
                                    </Button>
                                </Grid>

                                <TextBox Grid.Row="1" x:Name="SummaryBox" Style="{StaticResource PathBox}"
                                         Height="Auto" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" FontSize="13"
                                         VerticalContentAlignment="Top"/>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>

            <!-- ══════════ Задача и статус ══════════ -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Длинная работа LLM: коррекция встречи идёт минутами, и до сих пор
                     прервать её можно было только закрыв приложение. Полоса — волосок в 4 px
                     и отдельной строки почти не занимает: полноценный блок с кнопкой отбирал
                     41 px высоты, и карточки слева обрезались на 17 px, стоило начать работу. -->
                <ProgressBar Grid.Row="0" x:Name="TaskBar" Style="{StaticResource TaskProgress}"
                             x:FieldModifier="private" Visibility="Collapsed" Margin="0,0,0,4"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="2" x:Name="CancelTaskBtn" Style="{StaticResource GhostButton}"
                            Click="CancelTask_Click" Margin="10,0,0,0" Visibility="Collapsed"
                            ToolTip="{l:Tr 'Прервать работу модели', En='Stop the model'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="12" Margin="0,1,7,0"/>
                            <TextBlock Text="{l:Tr Отмена, En=Cancel}" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <!-- Иконка и цвет отличают ошибку от прогресса: раньше и то и другое
                         было одинаковой серой строкой. -->
                    <TextBlock Grid.Column="0" x:Name="StatusIcon" FontFamily="Segoe MDL2 Assets"
                               Text="&#xE930;" FontSize="12" Margin="0,1,8,0"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="Status" Text="{l:Tr 'Готово к записи.', En='Ready to record.'}"
                               Foreground="{StaticResource MutedBrush}" FontSize="12"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" x:Name="OpenFolderBtn" Style="{StaticResource GhostButton}"
                            Click="OpenFolder_Click" Margin="10,0,0,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE838;" FontSize="13" Margin="0,1,7,0"/>
                            <TextBlock Text="{l:Tr 'Показать файл', En='Show file'}" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
