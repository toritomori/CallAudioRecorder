# Проект собирается и живёт только под Windows: в рабочей копии — CRLF,
# в репозитории — LF. Так перевод строк не зависит от core.autocrlf у клонирующего.
* text=auto eol=crlf

# Бинарные файлы нормализовать нельзя — испортятся.
